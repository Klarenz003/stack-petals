# Stack Petals — environment variables
# Copy this file to .env and fill in your values

# Supabase (add when you migrate from localStorage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Node.js/Express API base URL (add when your backend is ready)
VITE_API_BASE_URL=http://localhost:3001

# Optional donation/support destination shown after a letter is completed.
# Example: a GCash/Maya payment page, Stripe Payment Link, or donation form.
VITE_DONATION_URL=https://stackoverpetals.shop/contact?subject=Support%20Stack%20Petals
